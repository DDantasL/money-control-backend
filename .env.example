DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_control
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# Autenticação — obrigatório trocar em produção (ex.: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limit no login/setup (por IP)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Opcional: cria a primeira conta automaticamente se o banco estiver vazio
# INITIAL_ADMIN_EMAIL=admin@familia.com
# INITIAL_ADMIN_PASSWORD=SuaSenhaSegura1
